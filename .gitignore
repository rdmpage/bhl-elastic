.DS_Store
bhl.db
bhl.db-*
env.php
cache/

# Keep the bhldata folder and its provenance file, ignore the dumps themselves
bhldata/*
!bhldata/last-updated.txt

# OCR archive manifests are derived data; keep only the docs
bhlocr/*
!bhlocr/*.md
*.checkpoint
vendor/

# Page sizes and word boxes from bhl-ocr-store (9 GB); keep only the docs
bhl-ocr-store/*
!bhl-ocr-store/*.md

# BBEdit project: share the project file, not each person's settings, lock or worksheets
*.bbprojectd/*
!*.bbprojectd/project.bbprojectdata
